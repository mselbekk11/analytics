{
  "name": "analytics",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build:script && npm run build:map-worker",
    "dev": "next dev",
    "prebuild": "npm run build:script && npm run build:map-worker",
    "build": "next build",
    "build:map-worker": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/maplibre-gl-worker.js",
    "build:script": "esbuild src/script/script.js --minify --target=es5 --outfile=public/script.js --log-level=warning",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.9.15",
    "@vercel/functions": "^3.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "convex": "^1.46.0",
    "date-fns": "^4.4.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.63.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "stripe": "^23.0.1",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^1.0.41"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ua-parser-js": "^0.7.39",
    "convex-test": "^0.0.61",
    "esbuild": "^0.27.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
