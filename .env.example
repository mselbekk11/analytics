# Written by `npx convex dev` into .env.local; set automatically by `npx convex deploy` on Vercel
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk Dashboard > API keys (.env.local and Vercel)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Shared secret between /api/collect and Convex (Phase 1). Same value in .env.local,
# Vercel and Convex env. Generate with: openssl rand -hex 32
INGEST_SECRET=

# Set on the Convex deployment, not here (npx convex env set ...):
#   CLERK_JWT_ISSUER_DOMAIN  Clerk Frontend API URL (dev and prod separately)
#   INGEST_SECRET            same value as above
# Set in Vercel only, Production scope:
#   CONVEX_DEPLOY_KEY        Convex production deploy key
